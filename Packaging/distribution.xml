<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Wisp</title>
    <organization>blog.evandev</organization>
    <welcome    file="welcome.html"    mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64"/>

    <volume-check>
        <allowed-os-versions><os-version min="26.0"/></allowed-os-versions>
    </volume-check>

    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Wisp">
        <pkg-ref id="com.evan.wisp"/>
    </choice>
    <pkg-ref id="com.evan.wisp" version="0.1.0" onConclusion="none">Wisp-component.pkg</pkg-ref>
</installer-gui-script>
